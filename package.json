{
  "name": "erai-raws-subs",
  "version": "0.1.0",
  "description": "Stremio subtitle addon for Erai-Raws ASS subtitles",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "worker": "node dist/crawler/worker.js",
    "erai:login": "tsx src/erai/smoke-login.ts",
    "crawl": "tsx src/crawler/run.ts",
    "crawl:worker": "tsx src/crawler/worker.ts",
    "metadata:resolve": "tsx src/metadata/run.ts",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/tough-cookie": "^4.0.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@stremio-addon/node-express": "^1.0.0",
    "@stremio-addon/sdk": "^1.0.0",
    "@stremio-addon/zod": "^1.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "got": "^15.1.0",
    "tough-cookie": "^6.0.2",
    "zod": "^4.4.3"
  }
}
