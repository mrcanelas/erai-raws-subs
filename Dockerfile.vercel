# syntax=docker/dockerfile:1
# Vercel Container Function image (auto-detected as Dockerfile.vercel).
# Listens on $PORT (Vercel default: 80). Scales to zero — use Cron for crawls.

FROM node:22-bookworm-slim AS build
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
COPY public ./public
RUN npx prisma generate && npx tsc && npm prune --omit=dev

FROM node:22-bookworm-slim AS runner
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
# Vercel injects PORT; default 80 matches Container Function docs.
ENV PORT=80
# In-process loop dies when the Function scales to zero — Cron triggers crawls.
ENV CRAWL_ENABLED=false
ENV CRAWL_RUN_ON_START=false
ENV CONFIGURATION_REQUIRED=true
ENV IMDB_MAPPING_PATH=/tmp/imdb_mapping.json

COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/public ./public
COPY scripts/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh \
  && sed -i 's/\r$//' /app/docker-entrypoint.sh

EXPOSE 80
ENTRYPOINT ["/app/docker-entrypoint.sh"]
