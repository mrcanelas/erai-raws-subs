PORT=7000
ADDON_PUBLIC_URL=http://127.0.0.1:7000

# SQLite (local development). Switch provider to postgresql later for production.
DATABASE_URL="file:./dev.db"

# Local ASS cache for the subtitle proxy
SUBTITLE_CACHE_DIR=.cache/subtitles

# Erai-Raws credentials for local/dev single-tenant runs.
# Production installs will collect these from the Stremio configure page.
ERAI_USERNAME=
ERAI_PASSWORD=
ERAI_BASE_URL=https://www.erai-raws.info
ERAI_COOKIE_PATH=.cache/erai-cookies.json
# Directory for per-tenant CookieJars created by the configure flow.
ERAI_COOKIE_DIR=.cache

# Required to encrypt Erai credentials collected via /configure.
# Use a long random string; changing it invalidates stored configurations.
CONFIG_SECRET=

# Background crawler (runs inside the addon process by default).
# Set CRAWL_ENABLED=false to serve subtitles only; use npm run crawl:worker instead.
CRAWL_ENABLED=true
CRAWL_ROOT_DIRECTORY=Sub
CRAWL_INTERVAL_MINUTES=360
CRAWL_DELAY_MS=400
CRAWL_RUN_ON_START=true

# Cached IMDb ↔ Kitsu mapping (downloaded on first metadata resolve)
IMDB_MAPPING_URL=https://raw.githubusercontent.com/TheBeastLT/stremio-kitsu-anime/master/static/data/imdb_mapping.json
IMDB_MAPPING_PATH=.cache/imdb_mapping.json
