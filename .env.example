PORT=7000
ADDON_PUBLIC_URL=http://127.0.0.1:7000

# Production (OVHcloud + docker compose): domain served by Caddy with automatic HTTPS
DOMAIN=erai.example.com
ACME_EMAIL=you@example.com

# Neon / PostgreSQL (required). Example with sslmode=require:
# postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Erai-Raws credentials for the in-process crawler.
# End users still authenticate via /configure; these server creds index Sub/.
ERAI_USERNAME=
ERAI_PASSWORD=
ERAI_BASE_URL=https://www.erai-raws.info

# Required to encrypt Erai credentials collected via /configure.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_SECRET=

# In-memory LRU for decompressed ASS (optional; Postgres remains durable).
MEMORY_CACHE_ENABLED=true
MEMORY_CACHE_MAX_ENTRIES=500

# Background crawler runs inside the addon process on OVHcloud.
CRAWL_ENABLED=true
CRAWL_ROOT_DIRECTORY=Sub
CRAWL_INTERVAL_MINUTES=360
CRAWL_DELAY_MS=400
CRAWL_RUN_ON_START=true

# Cached IMDb ↔ Kitsu mapping (re-fetched after restarts)
IMDB_MAPPING_URL=https://raw.githubusercontent.com/TheBeastLT/stremio-kitsu-anime/master/static/data/imdb_mapping.json
IMDB_MAPPING_PATH=/tmp/imdb_mapping.json

# On OVHcloud / production, force Stremio to open /configure even with ERAI_* set.
CONFIGURATION_REQUIRED=true
