PORT=7000
ADDON_PUBLIC_URL=http://127.0.0.1:7000

# --- Vercel Container Function (recommended) ---
# Set these in the Vercel project Environment Variables (Production + Preview).
# ADDON_PUBLIC_URL=https://your-project.vercel.app
# CRON_SECRET=...   # vercel env: Authorization Bearer for /api/cron/crawl
# CRAWL_ENABLED=false
# CRAWL_BUDGET_MS=240000

# --- OVHcloud / docker compose (optional self-host) ---
DOMAIN=erai.example.com
ACME_EMAIL=you@example.com

# Neon / PostgreSQL (required). Example with sslmode=require:
# postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Erai-Raws credentials for the crawler (Cron on Vercel, or in-process on VPS).
# End users still authenticate via /configure; these server creds index Sub/.
ERAI_USERNAME=
ERAI_PASSWORD=
ERAI_BASE_URL=https://www.erai-raws.info

# Required to encrypt Erai credentials collected via /configure.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_SECRET=

# Protects GET/POST /api/cron/crawl (Vercel Cron sends Authorization: Bearer …).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# In-memory LRU for decompressed ASS (optional; Postgres remains durable).
MEMORY_CACHE_ENABLED=true
MEMORY_CACHE_MAX_ENTRIES=500

# In-process loop: true on long-lived VPS; false on Vercel (use Cron instead).
CRAWL_ENABLED=false
CRAWL_ROOT_DIRECTORY=Sub
CRAWL_INTERVAL_MINUTES=360
CRAWL_DELAY_MS=400
CRAWL_RUN_ON_START=false
# Soft time budget for /api/cron/crawl (stay under Function maxDuration).
CRAWL_BUDGET_MS=240000

# Cached IMDb ↔ Kitsu mapping (re-fetched after cold starts)
IMDB_MAPPING_URL=https://raw.githubusercontent.com/TheBeastLT/stremio-kitsu-anime/master/static/data/imdb_mapping.json
IMDB_MAPPING_PATH=/tmp/imdb_mapping.json

# Force Stremio to open /configure even with ERAI_* set.
CONFIGURATION_REQUIRED=true
