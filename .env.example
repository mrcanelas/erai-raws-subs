PORT=7000
ADDON_PUBLIC_URL=http://127.0.0.1:7000

# Neon / PostgreSQL (required). Beamup has no durable filesystem.
# Example: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Erai-Raws credentials for the crawler / local single-tenant runs.
# End users still authenticate via /configure; these server creds index Sub/.
ERAI_USERNAME=
ERAI_PASSWORD=
ERAI_BASE_URL=https://www.erai-raws.info

# Required to encrypt Erai credentials collected via /configure.
# Use a long random string; changing it invalidates stored configurations.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_SECRET=

# In-memory LRU for decompressed ASS (optional; Postgres remains durable).
MEMORY_CACHE_ENABLED=true
MEMORY_CACHE_MAX_ENTRIES=500

# Background crawler (runs inside the addon process by default).
# Set CRAWL_ENABLED=false to serve subtitles only; use npm run crawl:worker instead.
CRAWL_ENABLED=true
CRAWL_ROOT_DIRECTORY=Sub
CRAWL_INTERVAL_MINUTES=360
CRAWL_DELAY_MS=400
CRAWL_RUN_ON_START=true

# Cached IMDb ↔ Kitsu mapping (ephemeral download; re-fetched after restarts)
IMDB_MAPPING_URL=https://raw.githubusercontent.com/TheBeastLT/stremio-kitsu-anime/master/static/data/imdb_mapping.json
IMDB_MAPPING_PATH=/tmp/imdb_mapping.json

# When true, Stremio always opens /configure even if ERAI_* env creds exist
# (needed in production so crawler secrets don't skip the user login flow).
CONFIGURATION_REQUIRED=false
