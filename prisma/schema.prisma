generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Anime {
  id              String     @id @default(cuid())
  sourcePath      String     @unique @map("source_path")
  // Not unique: multi-season Erai folders often share one IMDb series id.
  imdb            String?
  kitsu           String?    @unique
  anilist         String?    @unique
  mal             String?    @unique
  tmdb            String?    @unique
  tvdb            String?    @unique
  // Stremio season number for this Erai entry (from imdb_mapping.fromSeason).
  imdbSeason      Int?       @map("imdb_season")
  canonicalTitle  String     @map("canonical_title")
  aliases         Json       @default("[]")
  startDate       DateTime?  @map("start_date")
  episodeCount    Int?       @map("episode_count")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  subtitles       Subtitle[]

  @@index([imdb])
  @@index([canonicalTitle])
  @@map("anime")
}

model Subtitle {
  id            String         @id @default(cuid())
  animeId       String         @map("anime_id")
  season        Int?
  episode       Int?
  language      String
  release       String?
  fileName      String         @map("file_name")
  hash          String?
  downloadUrl   String         @map("download_url")
  cacheId       String?        @unique @map("cache_id")
  lastVerified  DateTime?      @map("last_verified")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  anime         Anime          @relation(fields: [animeId], references: [id], onDelete: Cascade)
  cache         SubtitleCache? @relation(fields: [cacheId], references: [id], onDelete: SetNull)

  @@unique([animeId, season, episode, language, fileName])
  @@index([animeId, season, episode])
  @@index([language])
  @@index([hash])
  @@map("subtitles")
}

/// Gzipped ASS bytes. Survives Beamup container restarts (external Postgres).
model SubtitleCache {
  id             String    @id @default(cuid())
  content        Bytes
  compression    String    @default("gzip")
  size           Int
  createdAt      DateTime  @default(now()) @map("created_at")
  lastAccessedAt DateTime  @default(now()) @map("last_accessed_at")
  subtitle       Subtitle?

  @@map("subtitle_cache")
}

/// Serialized tough-cookie CookieJar per tenant (token) or "env" for the crawler.
model EraiSession {
  id        String   @id
  jarJson   String   @map("jar_json")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("erai_session")
}

model AddonConfig {
  id          String    @id @default(cuid())
  // Opaque token carried by the Stremio config URL. Credentials never leave
  // the server; only this token appears in client-facing URLs.
  token       String    @unique
  // AES-256-GCM encrypted JSON payload of the Erai credentials.
  secret      String
  iv          String
  authTag     String    @map("auth_tag")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")

  @@map("addon_config")
}

model SyncState {
  id             String    @id @default("default")
  lastSync       DateTime? @map("last_sync")
  lastDirectory  String?   @map("last_directory")
  status         String    @default("idle")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("sync_state")
}
